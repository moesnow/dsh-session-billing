{
  "name": "dsh-session-billing",
  "version": "1.0.0",
  "private": true,
  "description": "Per-session LLM cost meter for the DeepSeek Harness Web UI: folds provider usage into uncached input / cache read / cache write / output per model and prices it against DeepSeek and Xiaomi MiMo pay-as-you-go rates (DeepSeek peak-idle tiering included).",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "billing", "cost", "tokens", "cordis"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "client.js", "models.config.js", "locale/*.json", "icon.svg", "cordis.patch.yml", "README.md", "README.en.md"],
  "license": "GPL-3.0-only",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
